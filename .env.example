# 客户端可见变量（前缀 EXPO_PUBLIC_）
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_USE_MOCK=false

# mosi.cn 多说话人语音转写 API Key（https://platform.mosi.cn 控制台生成）
EXPO_PUBLIC_MOSS_API_KEY=your-moss-api-key

# 服务端变量（仅在 Supabase Edge Function 后端使用，不暴露到客户端）
# ZHIPU_API_KEY=sk-...  写在 Supabase Edge Function secrets 里：supabase secrets set ZHIPU_API_KEY=...
