# 客户端可见变量（前缀 EXPO_PUBLIC_）
# Mock 模式：auth/DB 用预置数据；ASR/LLM 由各自 KEY 是否配置决定走真实接口
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_USE_MOCK=false

# mosi.cn 多说话人语音转写 API Key（https://platform.mosi.cn 控制台生成）
EXPO_PUBLIC_MOSS_API_KEY=your-moss-api-key

# 智谱 GLM API Key（https://open.bigmodel.cn 控制台获取）
# 注：客户端直连为 demo 妥协，赛后迁 Supabase Edge Function 中转（key 留服务端）
EXPO_PUBLIC_ZHIPU_API_KEY=your-zhipu-api-key

# —— 以下两项可省略 —— 留空即走默认 glm-4-flash + 官方 base
# 模型名（支持 glm-4-flash / glm-4-plus / glm-4-air / glm-4.7-flash），不在白名单会自动回退到 glm-4-flash 防 404
EXPO_PUBLIC_LLM_MODEL=glm-4-flash
# 切换其他 OpenAI 兼容端点时改这里（例：通义千问 DashScope 兼容端点 → https://dashscope.aliyuncs.com/compatible-mode/v1）
EXPO_PUBLIC_ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 服务端变量（仅在 Supabase Edge Function 后端使用，不暴露到客户端）
# 迁移到 EF 后：supabase secrets set ZHIPU_API_KEY=sk-...，并删除上面的 EXPO_PUBLIC_ZHIPU_API_KEY
